{
  "name": "mega-suite-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Núcleo modular multiempresa para inventario, logística, planner, ventas y ticketing.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js || sleep 3600",
    "accounting:backfill": "node scripts/backfill-accounting.js",
    "backup": "node scripts/backup.js",
    "backup:restore": "node scripts/restore-backup.js",
    "services:up": "docker compose up -d postgres redis",
    "services:down": "docker compose down",
    "services:wait": "node scripts/wait-for-services.js",
    "setup:local": "npm run services:up && npm run services:wait && npm run migrate",
    "test": "node --test",
    "test:integration": "node --test test/multi-company.integration.test.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/migrate.js && node --test",
    "deploy": "node scripts/deploy-hostinger.js update",
    "deploy:status": "node scripts/deploy-hostinger.js status",
    "deploy:restart": "node scripts/deploy-hostinger.js restart"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
