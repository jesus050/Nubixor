NODE_ENV=development
PORT=4100
APP_NAME=Nubixor
PUBLIC_BASE_URL=http://localhost:4100

# Credenciales exclusivamente locales para los contenedores de desarrollo.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/megasuite
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000

REDIS_URL=redis://localhost:6379/0

# Use una lista separada por comas en producción, sin barra final.
CORS_ORIGINS=http://localhost:4100,http://127.0.0.1:4100,http://localhost:5173
TRUST_PROXY=false
JSON_BODY_LIMIT=3mb
STORAGE_DIR=./storage

# Recuperación de contraseña. En producción debe apuntar a un webhook HTTPS
# de correo transaccional que acepte recipient, resetUrl y expiresInMinutes.
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_SECRET=

# Copias automáticas cifradas. Genere 32 bytes con:
# openssl rand -base64 32
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=

# Obligatoria antes de guardar credenciales reales del proveedor. Genere un
# secreto largo y exclusivo por ambiente; nunca lo confirme en el repositorio.
ELECTRONIC_BILLING_ENCRYPTION_KEY=
